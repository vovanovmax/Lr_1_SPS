@model WebApplication2.Models.FileViewModel
@{
    ViewData["Title"] = "Перегляд файлу: " + Model.Name;
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
        <h1>Перегляд файлу: @Model.Name</h1>
        <div>
            <a href="~/Files/@Model.Name" download class="btn btn-success me-2">
                <i class="fas fa-download me-1"></i> Завантажити
            </a>
            <a asp-controller="Home" asp-action="Files" class="btn btn-secondary">
                &laquo; Назад до списку
            </a>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            Розмір: <strong>@Model.Size</strong> | Останнє оновлення: <strong>@Model.LastModified.ToString("dd.MM.yyyy HH:mm:ss")</strong>
        </div>
        <div class="card-body">
            @if (Model.FileCategory == "image")
            {
                <div class="text-center">
                    <img src="~/Files/@Model.Name" alt="@Model.Name" class="img-fluid rounded border shadow-sm" style="max-height: 600px;" />
                </div>
            }
            else if (Model.FileCategory == "pdf")
            {
                <iframe src="~/Files/@Model.Name" width="100%" height="650px" class="border rounded"></iframe>
            }
            else if (Model.FileCategory == "text")
            {
                <pre class="bg-light p-3 border rounded" style="max-height: 600px; overflow-y: auto; white-space: pre-wrap;">@Model.TextContent</pre>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    Попередній перегляд у браузері для формату <strong>@Model.Extension</strong> не підтримується. Ви можете завантажити цей файл за допомогою кнопки вище.
                </div>
            }
        </div>
    </div>
</div>